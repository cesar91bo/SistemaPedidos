@page "/pedidos"
@rendermode InteractiveServer

@using SistemaPedidos.Application.Features.Parametros.DTOs
@using SistemaPedidos.Application.Features.Pedidos.DTOs
@using SistemaPedidos.Application.Features.Pedidos.Interfaces
@using SistemaPedidos.Application.Features.Productos.DTOs
@using SistemaPedidos.Application.Features.Productos.Interfaces
@using SistemaPedidos.Application.Features.Ventas
@using SistemaPedidos.Application.Features.Ventas.DTOs
@using SistemaPedidos.Domain.Enums
@using SistemaPedidos.Domain.Enums.SistemaPedidos.Domain.Enums
@using SistemaPedidos.Infrastructure.Services.Ventas
@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using SistemaPedidos.Application.Features.Parametros.Interfaces
@using SistemaPedidos.Application.Features.Deliveries.DTOs
@using SistemaPedidos.Application.Features.Deliveries.Interfaces

@inject IPedidoService PedidoService
@inject IProductoService ProductoService
@inject IVentaService VentaService
@inject IParametroService ParametroService
@inject IDeliveryService DeliveryService

@inject NavigationManager NavigationManager

<h3>Gestión de Pedidos</h3>

<div class="row">

    <!-- Panel creación -->
    <div class="col-md-6 border p-3">

        <h5>Nuevo Pedido</h5>

        <div class="mb-2">
            <label>Nombre Cliente</label>
            <input class="form-control @(intentoGuardar && string.IsNullOrWhiteSpace(nombreCliente) ? "is-invalid" : "")"
                   @bind="nombreCliente" />

            @if (intentoGuardar && string.IsNullOrWhiteSpace(nombreCliente))
            {
                <div class="invalid-feedback">
                    El nombre del cliente es obligatorio.
                </div>
            }
        </div>

        <div class="mb-2">
            <label>Teléfono</label>
            <input class="form-control" @bind="telefono" />
        </div>

        <div class="mb-2">
            <label>Tipo Pedido</label>
            <select class="form-select" @bind="tipoPedido">
                <option value="1">Retiro</option>
                <option value="2">Delivery</option>
            </select>
        </div>

        @if (tipoPedido == 2)
        {
            <div class="mb-2">
                <label>Dirección</label>

                <input class="form-control @(intentoGuardar && string.IsNullOrWhiteSpace(direccion) ? "is-invalid" : "")"
                       @bind="direccion" />

                @if (intentoGuardar && string.IsNullOrWhiteSpace(direccion))
                {
                    <div class="invalid-feedback">
                        Debe ingresar la dirección para un pedido delivery.
                    </div>
                }
            </div>

            <div class="mb-2">
                <label>Precio Envío</label>

                <input type="number"
                       class="form-control @(intentoGuardar && precioEnvio <= 0 ? "is-invalid" : "")"
                       @bind="precioEnvio" />

                @if (intentoGuardar && precioEnvio <= 0)
                {
                    <div class="invalid-feedback">
                        Debe ingresar un precio de envío.
                    </div>
                }
            </div>
        }

        <hr />

        <h6>Agregar Producto</h6>

        <select class="form-select mb-2 @(intentoAgregarProducto && productoSeleccionadoId == 0 ? "is-invalid" : "")"
                @bind="productoSeleccionadoId">
            <option value="0">Seleccione producto</option>
            @foreach (var p in productos)
            {
                <option value="@p.Id">@p.Nombre (@p.PrecioActual.ToString("C"))</option>
            }
        </select>

        @if (intentoAgregarProducto && productoSeleccionadoId == 0)
        {
            <div class="invalid-feedback d-block mb-2">
                Debe seleccionar un producto.
            </div>
        }

        <input type="number"
               class="form-control mb-2 @(intentoAgregarProducto && cantidad <= 0 ? "is-invalid" : "")"
               @bind="cantidad"
               placeholder="Cantidad" />

        @if (intentoAgregarProducto && cantidad <= 0)
        {
            <div class="invalid-feedback d-block mb-2">
                La cantidad debe ser mayor a 0.
            </div>
        }
        <textarea class="form-control mb-2"
                  rows="2"
                  maxlength="150"
                  @bind="observacionProducto"
                      placeholder="Detalle opcional">
        </textarea>
        <button class="btn btn-success" @onclick="AgregarItem">
            Agregar
        </button>

        <hr />

        <h6>Items</h6>

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cant</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                            <td>
                                <div>@item.ProductoNombre</div>

                                @if (!string.IsNullOrWhiteSpace(item.Observacion))
                                {
                                    <small class="text-muted fst-italic">
                                        @item.Observacion
                                    </small>
                                }
                            </td>
                        <td>@item.Cantidad</td>
                        <td>@item.Subtotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (intentoGuardar && !items.Any())
        {
            <div class="alert alert-danger mt-2">
                Debe agregar al menos un producto al pedido.
            </div>
        }
    </div>

    <!-- Panel resumen -->
    <div class="col-md-6 border p-3">

        <h5>Resumen</h5>

        <p>Total Productos: @totalProductos.ToString("C")</p>
        <p>Envío: @precioEnvio.ToString("C")</p>
        <hr />
        <h4>Total General: @totalGeneral.ToString("C")</h4>

        <button class="btn btn-primary"
                disabled="@guardando"
                @onclick="GuardarPedido">
            Guardar Pedido
        </button>

    </div>
</div>
<hr />

<h4>Pedidos Activos</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Cliente</th>
            <th>Tipo</th>
            <th>Detalle</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Hora</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var pedido in pedidosActivos)
        {
            <tr>
                <td>@pedido.Id</td>
                <td>@pedido.NombreCliente</td>
                <td title="@(pedido.TipoPedidoNombre == "Delivery" && !string.IsNullOrWhiteSpace(pedido.DeliveryNombre)
                                                                                                                                                            ? $"Envía: {pedido.DeliveryNombre}"
                                                                                                                                                            : "")">

                    @if (pedido.TipoPedidoNombre == "Delivery")
                    {
                        <span style="cursor: help; text-decoration: underline dotted;">
                            @pedido.TipoPedidoNombre
                        </span>
                    }
                    else
                    {
                        @pedido.TipoPedidoNombre
                    }
                </td>
                <td>
                    @foreach (var item in pedido.Items)
                    {
                        <div>
                            @item.Cantidad x @item.ProductoNombre
                        </div>
                    }
                </td>
                <td>@pedido.EstadoNombre</td>
                <td>@pedido.TotalGeneral.ToString("C")</td>
                <td>@pedido.Fecha.ToString("HH:mm")</td>
                <td>
                    @if (pedido.Estado == (int)EstadoPedido.EnPreparacion)
                    {
                        <button class="btn btn-sm btn-warning"
                                @onclick="() => CambiarEstado(pedido.Id, (int)EstadoPedido.Listo)">
                            Listo
                        </button>
                    }
                    else if (pedido.Estado == (int)EstadoPedido.Listo)
                    {
                        @if (pedido.TipoPedido == 2) // Delivery
                        {
                            <button class="btn btn-sm btn-primary"
                                    @onclick="() => AbrirModalEnviar(pedido)">
                                Enviar
                            </button>
                        }
                        else // Retiro
                        {
                            <button class="btn btn-sm btn-success"
                                    @onclick="() => AbrirCobro(pedido)">
                                Cobrar
                            </button>
                        }
                    }
                    else if (pedido.Estado == (int)EstadoPedido.EnCamino)
                    {
                        <button class="btn btn-sm btn-success"
                                @onclick="() => AbrirCobro(pedido)">
                            Cobrar
                        </button>
                    }
                </td>

            </tr>
        }
    </tbody>

</table>

@if (mostrarModalCobro && pedidoCobro != null)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content p-3">

                <h5>Cobrar Pedido #@pedidoCobro.Id</h5>

                <p>Total: @pedidoCobro.TotalGeneral.ToString("C")</p>

                @foreach (var pago in pagos)
                {
                    <div class="row mb-2">
                        <div class="col">
                            <select class="form-select" @bind="pago.FormaPago">
                                @foreach (var forma in Enum.GetValues<FormaPago>())
                                {
                                    <option value="@forma">
                                        @(forma.GetType().GetField(forma.ToString())?.GetCustomAttribute<DisplayAttribute>()?.Name ?? forma.ToString())
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col">
                            <input type="number"
                                   class="form-control"
                                   @bind="pago.Monto" />
                        </div>
                    </div>
                }

                <button class="btn btn-secondary mb-2"
                        @onclick="() => pagos.Add(new RegistrarPagoDto { FormaPago = FormaPago.Efectivo, Monto = Saldo })">
                    Agregar otro medio
                </button>

                <p>Total Pagado: @TotalPagado.ToString("C")</p>
                <p>Saldo: @Saldo.ToString("C")</p>

                <button class="btn btn-success"
                        disabled="@(TotalPagado != pedidoCobro.TotalGeneral)"
                        @onclick="ConfirmarCobro">
                    Confirmar
                </button>

                <button class="btn btn-danger"
                        @onclick="() => mostrarModalCobro = false">
                    Cancelar
                </button>

            </div>
        </div>
    </div>
}

@if (mostrarModalDelivery && pedidoEnviar != null)
{
    <div class="modal show d-block" tabindex="-1" style="background: rgba(0,0,0,.4)">
        <div class="modal-dialog">
            <div class="modal-content p-3">

                <h5>Seleccionar Delivery</h5>

                <p>
                    Pedido #@pedidoEnviar.Id - @pedidoEnviar.NombreCliente
                </p>

                <select class="form-select mb-3" @bind="deliveryParaEnviarId">
                    <option value="0">Seleccione delivery</option>

                    @foreach (var d in deliveries)
                    {
                        <option value="@d.Id">@d.Nombre</option>
                    }
                </select>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary"
                            disabled="@(deliveryParaEnviarId == 0)"
                            @onclick="ConfirmarEnviar">
                        Confirmar envío
                    </button>

                    <button class="btn btn-secondary"
                            @onclick="CerrarModalEnviar">
                        Cancelar
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    private bool intentoGuardar = false;
    private bool intentoAgregarProducto = false;

    private List<ProductoDto> productos = new();
    private List<PedidoItemDto> items = new();

    private string nombreCliente = "";
    private string telefono = "";
    private string? direccion;

    private decimal ultimoPrecioEnvio = 0;
    private decimal precioEnvio = 0;

    private int _tipoPedido = 1;

    private int tipoPedido
    {
        get => _tipoPedido;
        set
        {
            _tipoPedido = value;

            if (_tipoPedido == 2)
            {
                precioEnvio = ultimoPrecioEnvio;
            }
            else
            {
                precioEnvio = 0;
                direccion = null;
            }
        }
    }

    private int productoSeleccionadoId = 0;
    private int cantidad = 1;

    private decimal totalProductos => items.Sum(i => i.Subtotal);
    private decimal totalGeneral => totalProductos + precioEnvio;

    private bool guardando = false;
    private List<PedidoDto> pedidosActivos = new();

    private PedidoDto? pedidoCobro;
    private List<RegistrarPagoDto> pagos = new();
    private bool mostrarModalCobro = false;

    private decimal TotalPagado => pagos.Sum(p => p.Monto);
    private decimal Saldo => (pedidoCobro?.TotalGeneral ?? 0) - TotalPagado;

    private List<DeliveryDto> deliveries = new();
    private int deliverySeleccionadoId = 0;

    private bool mostrarModalDelivery = false;
    private PedidoDto? pedidoEnviar;
    private int deliveryParaEnviarId = 0;

    private string observacionProducto = "";

    protected override async Task OnInitializedAsync()
    {
        productos = await ProductoService.ObtenerTodosAsync();

        deliveries = await DeliveryService.ObtenerSoloActivosAsync();

        var parametro = await ParametroService.ObtenerPorCodigoAsync("PRECIO_ENVIO");

        if (parametro != null &&
            decimal.TryParse(parametro.Valor, out var valor))
        {
            ultimoPrecioEnvio = valor;
        }
        else
        {
            ultimoPrecioEnvio = 0;
        }

        await CargarPedidosActivos();
    }

    private async Task CargarPedidosActivos()
    {
        pedidosActivos = await PedidoService.ObtenerActivosAsync();
    }


    private void AgregarItem()
    {
        intentoAgregarProducto = true;

        if (productoSeleccionadoId == 0 || cantidad <= 0)
            return;

        var producto = productos.FirstOrDefault(p => p.Id == productoSeleccionadoId);

        if (producto == null)
            return;

        var itemExistente = items.FirstOrDefault(i => i.ProductoId == producto.Id);

        if (itemExistente != null)
        {
            itemExistente.Cantidad += cantidad;
            itemExistente.Subtotal = itemExistente.Cantidad * itemExistente.PrecioUnitario;
        }
        else
        {
            items.Add(new PedidoItemDto
            {
                ProductoId = producto.Id,
                ProductoNombre = producto.Nombre,
                Cantidad = cantidad,
                PrecioUnitario = producto.PrecioActual,
                Subtotal = producto.PrecioActual * cantidad,
                Observacion = observacionProducto
            });
        }

        productoSeleccionadoId = 0;
        observacionProducto = "";
        cantidad = 1;
        intentoAgregarProducto = false;
    }

    private async Task GuardarPedido()
    {
        intentoGuardar = true;

        if (string.IsNullOrWhiteSpace(nombreCliente))
            return;

        if (!items.Any())
        {
            intentoAgregarProducto = true;
            return;
        }

        if (tipoPedido == 2 && string.IsNullOrWhiteSpace(direccion))
            return;

        if (tipoPedido == 2 && precioEnvio <= 0)
            return;

        if (tipoPedido == 2 && precioEnvio <= 0)
            return;

        if (guardando)
            return;

        guardando = true;

        try
        {
            var dto = new CrearPedidoDto
            {
                NombreCliente = nombreCliente,
                Telefono = telefono,
                Direccion = direccion,
                TipoPedido = tipoPedido,
                PrecioEnvio = precioEnvio,
                DeliveryId = null,
                Items = items.Select(i => new CrearPedidoItemDto
                {
                    ProductoId = i.ProductoId,
                    ProductoNombre = i.ProductoNombre,
                    Cantidad = i.Cantidad,
                    Observacion = i.Observacion
                }).ToList()
            };

            var pedidoId = await PedidoService.CrearAsync(dto);

            NavigationManager.NavigateTo($"/pedidos/comanda/{pedidoId}", true);


            if (tipoPedido == 2 && precioEnvio > 0 && precioEnvio != ultimoPrecioEnvio)
            {
                var parametro = await ParametroService.ObtenerPorCodigoAsync("PRECIO_ENVIO");

                if (parametro == null)
                {
                    await ParametroService.CrearAsync(new CrearParametroDto
                    {
                        Codigo = "PRECIO_ENVIO",
                        Valor = precioEnvio.ToString(),
                        Grupo = "DELIVERY",
                        Descripcion = "Precio del Envío",
                        Tipo = TipoParametro.Decimal
                    });
                }
                else
                {
                    await ParametroService.ActualizarAsync(parametro.Id,
                        new ActualizarParametroDto
                        {
                            Valor = precioEnvio.ToString(),
                            Grupo = parametro.Grupo,
                            Descripcion = parametro.Descripcion,
                            Activo = parametro.Activo
                        });
                }

                ultimoPrecioEnvio = precioEnvio;
            }

            nombreCliente = "";
            telefono = "";
            direccion = null;
            tipoPedido = 1;
            deliverySeleccionadoId = 0;
            items.Clear();

            intentoGuardar = false;
            intentoAgregarProducto = false;

            await CargarPedidosActivos();
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task CambiarEstado(int pedidoId, int nuevoEstado)
    {
        await PedidoService.CambiarEstadoAsync(pedidoId, nuevoEstado);
        await CargarPedidosActivos();
    }

    private void AbrirCobro(PedidoDto pedido)
    {
        pedidoCobro = pedido;
        pagos = new List<RegistrarPagoDto>
        {
            new RegistrarPagoDto { FormaPago = FormaPago.Efectivo, Monto = pedido.TotalGeneral }
        };
        mostrarModalCobro = true;
    }

    private async Task ConfirmarCobro()
    {
        if (pedidoCobro == null)
            return;

        if (TotalPagado != pedidoCobro.TotalGeneral)
            return;

        await VentaService.RegistrarVentaAsync(pedidoCobro.Id, pagos);

        mostrarModalCobro = false;
        await CargarPedidosActivos();
    }

    private void AbrirModalEnviar(PedidoDto pedido)
    {
        pedidoEnviar = pedido;
        deliveryParaEnviarId = 0;
        mostrarModalDelivery = true;
    }

    private void CerrarModalEnviar()
    {
        mostrarModalDelivery = false;
        pedidoEnviar = null;
        deliveryParaEnviarId = 0;
    }

    private async Task ConfirmarEnviar()
    {
        if (pedidoEnviar == null || deliveryParaEnviarId == 0)
            return;

        await PedidoService.AsignarDeliveryAsync(
            pedidoEnviar.Id,
            deliveryParaEnviarId);

        await PedidoService.CambiarEstadoAsync(
            pedidoEnviar.Id,
            (int)EstadoPedido.EnCamino);

        CerrarModalEnviar();
        await CargarPedidosActivos();
    }

}
