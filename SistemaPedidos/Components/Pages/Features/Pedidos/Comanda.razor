@page "/pedidos/comanda/{Id:int}"
@rendermode InteractiveServer

@using Microsoft.EntityFrameworkCore.Metadata.Internal
@using SistemaPedidos.Application.Features.Pedidos.DTOs
@using SistemaPedidos.Application.Features.Pedidos.Interfaces

@inject IPedidoService PedidoService

@inject NavigationManager NavigationManager

<PageTitle>@($"Pedido_{pedido?.NombreCliente}_{pedido?.Id}_{pedido?.Fecha:yyyyMMdd_HHmm}")</PageTitle>

@if (pedido == null)
{
    <p>Cargando...</p>
}
else
{
    <div class="ticket-container">

        <div class="ticket-header">
            <img src="/images/Logo/conejo-logo-1.png" alt="Lebrón Delivery" />

            <div class="ticket-subtitle">
                Pedido #@pedido.Id
            </div>

            <div class="ticket-date">
                @pedido.Fecha.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <hr />

        <div class="ticket-section">
            <div><strong>Cliente:</strong> @pedido.NombreCliente</div>
            <div><strong>Tipo:</strong> @pedido.TipoPedidoNombre</div>

            @if (!string.IsNullOrWhiteSpace(pedido.Direccion))
            {
                <div><strong>Dirección:</strong> @pedido.Direccion</div>
            }

            @if (!string.IsNullOrWhiteSpace(pedido.Telefono))
            {
                <div><strong>Teléfono:</strong> @pedido.Telefono</div>
            }
        </div>

        <hr />

        <div class="ticket-section">
            @foreach (var item in pedido.Items)
            {
                <div class="item-block">
                    <div class="item-row">
                        <div>
                            @item.Cantidad x @item.ProductoNombre
                        </div>
                        <div>
                            @item.Subtotal.ToString("C0")
                        </div>
                    </div>
            
                    @if (!string.IsNullOrWhiteSpace(item.Observacion))
                    {
                        <div class="item-observacion">
                            • @item.Observacion
                        </div>
                    }
                </div>
            }
        </div>

        <hr />

        <div class="totals">

            @if (pedido.PrecioEnvio > 0)
            {
                <div class="item-row">
                    <span>Productos</span>
                    <span>@pedido.TotalProductos.ToString("C0")</span>
                </div>

                <div class="item-row">
                    <span>Envío</span>
                    <span>@pedido.PrecioEnvio.ToString("C0")</span>
                </div>
            }

            <div class="item-row total">
                <span>TOTAL</span>
                <span>@pedido.TotalGeneral.ToString("C0")</span>
            </div>

            <div class="ticket-footer">
                <strong>¡Gracias por elegirnos!</strong>
                <div>Te esperamos nuevamente</div>

                <div class="company-phone">
                    <div class="company-phone-label">
                        Consultas y pedidos
                    </div>

                    <div class="company-phone-number">
                        3644105455
                    </div>
                </div>
            </div>
        </div>

        <div class="actions no-print">
            <button class="btn btn-primary" @onclick="Imprimir">
                Imprimir
            </button>

            <button class="btn btn-secondary" @onclick="Volver">
                Volver
            </button>
        </div>
    </div>
}

<style>
    .ticket-container {
        width: 76mm;
        margin: 0 auto;
        background: white;
        padding: 4mm 2mm;
        font-family: Arial, sans-serif;
        color: #000;
        font-size: 15px;
        font-weight: 600;
    }

    .ticket-header {
        text-align: center;
    }

        .ticket-header img {
            width: 220px;
            max-width: 100%;
            display: block;
            margin: 0 auto 10px auto;
        }

    .ticket-subtitle {
        font-size: 22px;
        font-weight: bold;
        color: #000;
        margin-top: 4px;
    }

    .ticket-date {
        font-size: 18px;
        font-weight: bold;
        color: #000;
        margin-top: 4px;
    }

    .ticket-section {
        font-size: 16px;
        line-height: 1.6;
        color: #000;
    }

        .ticket-section strong {
            color: #000;
            font-weight: 800;
        }

    .item-block {
        margin-bottom: 10px;
    }

    .item-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-size: 16px;
        font-weight: 700;
        color: #000;
    }

    .item-observacion {
        margin-left: 6px;
        margin-top: 2px;
        font-size: 14px;
        font-style: normal;
        font-weight: 700;
        color: #000;
    }

    .totals {
        margin-top: 12px;
    }

    .total {
        font-size: 24px;
        font-weight: 900;
        margin-top: 12px;
        color: #000;
    }

    .ticket-footer {
        text-align: center;
        margin-top: 24px;
        font-size: 16px;
        line-height: 1.6;
        color: #000;
        font-weight: 700;
    }

        .ticket-footer strong {
            display: block;
            font-size: 24px;
            font-weight: 900;
            color: #000;
            margin-bottom: 8px;
        }

    .company-phone {
        margin-top: 20px;
        padding-top: 12px;
        border-top: 2px dashed #000;
        text-align: center;
    }

    .company-phone-label {
        font-size: 14px;
        color: #000;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 6px;
    }

    .company-phone-number {
        font-size: 22px;
        font-weight: 900;
        color: #000;
        letter-spacing: 2px;
    }

    hr {
        border: 0;
        border-top: 2px dashed #000;
        margin: 12px 0;
    }

    @@media print {

        body * {
            visibility: hidden;
        }

        .ticket-container,
        .ticket-container * {
            visibility: visible;
        }

        .ticket-container {
            position: absolute;
            left: 0;
            top: 0;
            width: 76mm;
            margin: 0;
            padding: 2mm 1mm;
            background: white;
        }

        * {
            color: #000 !important;
            opacity: 1 !important;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .no-print,
        nav,
        aside,
        header,
        footer,
        .sidebar,
        .top-row {
            display: none !important;
        }
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private PedidoDto? pedido;

    protected override async Task OnInitializedAsync()
    {
        pedido = await PedidoService.ObtenerPorIdAsync(Id);
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("print");
    }

    private void Volver()
    {
        NavigationManager.NavigateTo("/pedidos");
    }

    [Inject]
    private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.focus");
        }
    }
}