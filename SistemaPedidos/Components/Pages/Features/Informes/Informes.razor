@page "/informes"
@rendermode InteractiveServer
@using SistemaPedidos.Application.Features.Deliveries.Interfaces
@using SistemaPedidos.Application.Features.Deliveries.DTOs
@using SistemaPedidos.Application.Features.Ventas
@using SistemaPedidos.Application.Features.Ventas.DTOs
@using SistemaPedidos.Application.Features.Informes.DTOs
@using SistemaPedidos.Application.Features.Informes.Interfaces
@using SistemaPedidos.Domain.Enums

@inject IInformeService InformeService
@inject IVentaService VentaService
@inject IPagoDeliveryService PagoDeliveryService
@inject IJSRuntime JS

<div class="reports-page">

    <div class="reports-header">
        <div>
            <h1>Informes</h1>
            <p>Consultá ventas y pedidos por período</p>
        </div>

        <button class="btn-print" @onclick="Imprimir">
            🖨️ Imprimir
        </button>
    </div>

    <div class="filters-card">
        <div class="filter-group">
            <label>Período</label>
            <select class="form-select" @bind="PeriodoSeleccionado">
                <option value="Hoy">Hoy</option>
                <option value="Esta semana">Esta semana</option>
                <option value="Este mes">Este mes</option>
                <option value="Personalizado">Personalizado</option>
            </select>
        </div>

        <div class="filter-group">
            <label>Desde</label>
            <input type="date"
                   class="form-control"
                   @bind="FechaDesde"
                   disabled="@(PeriodoSeleccionado != "Personalizado")" />
        </div>

        <div class="filter-group">
            <label>Hasta</label>
            <input type="date"
                   class="form-control"
                   @bind="FechaHasta"
                   disabled="@(PeriodoSeleccionado != "Personalizado")" />
        </div>

        <div class="filter-group">
            <label>&nbsp;</label>
            <button type="button"
                    class="btn-search"
                    @onclick="async () => await BuscarAsync()">
                Buscar
            </button>
        </div>
    </div>

    <div id="area-imprimir">
        <div class="stats-grid">

            <div class="stat-card">
                <div>
                    <span class="stat-title">Ventas Totales</span>
                    <h2>@Informe.VentasTotales.ToString("C0")</h2>
                    <small>@Informe.CantidadVentas ventas realizadas</small>
                </div>
                <div class="stat-icon green">💰</div>
            </div>

            <div class="stat-card">
                <div>
                    <span class="stat-title">Pedidos Delivery</span>
                    <h2>@Informe.PedidosDelivery</h2>
                    <small>
                        @(Informe.CantidadVentas > 0
                            ? $"{(Informe.PedidosDelivery * 100 / (Informe.PedidosDelivery + Informe.PedidosRetiro))}% del total"
                            : "0% del total")
                    </small>
                </div>
                <div class="stat-icon blue">🛵</div>
            </div>

            <div class="stat-card">
                <div>
                    <span class="stat-title">Pedidos Retiro</span>
                    <h2>@Informe.PedidosRetiro</h2>
                    <small>
                        @(Informe.CantidadVentas > 0
                            ? $"{(Informe.PedidosRetiro * 100 / (Informe.PedidosDelivery + Informe.PedidosRetiro))}% del total"
                            : "0% del total")
                    </small>
                </div>
                <div class="stat-icon yellow">🛍️</div>
            </div>

            <div class="stat-card">
                <div>
                    <span class="stat-title">Promedio por Venta</span>
                    <h2>@Informe.PromedioPorVenta.ToString("C0")</h2>
                    <small>Por pedido cobrado</small>
                </div>
                <div class="stat-icon purple">📈</div>
            </div>

        </div>

        <div class="reports-content">

            <div class="report-card large">
                <div class="card-header">
                    <h3>Ventas por forma de pago</h3>
                </div>

                <table class="table-report">
                    <thead>
                        <tr>
                            <th>Forma de Pago</th>
                            <th>Cantidad</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Informe.FormasPago)
                        {
                            <tr>
                                <td>@item.Nombre</td>
                                <td>@item.Cantidad</td>
                                <td>@item.Total.ToString("C0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="report-card">
                <div class="card-header">
                    <h3>Productos más vendidos</h3>
                </div>

                @if (Informe.ProductosMasVendidos.Any())
                {
                    @foreach (var producto in Informe.ProductosMasVendidos)
                    {
                        <div class="top-product">
                            <span class="product-name">@producto.Nombre</span>
                            <strong>@producto.Cantidad</strong>
                        </div>
                    }
                }
                else
                {
                    <div class="empty-report">No hay productos vendidos</div>
                }
            </div>

            <div class="report-card">
                <div class="card-header">
                    <h3>Deliveries a pagar</h3>
                </div>

                @if (Informe.Deliveries.Any())
                {
                    @foreach (var delivery in Informe.Deliveries)
                    {
                        <div class="delivery-row">
                            <div>
                                <strong>🛵 @delivery.Nombre</strong>

                                <div class="delivery-detail">
                                    @delivery.CantidadEnvios envíos
                                </div>
                            </div>

                            <div style="display:flex; align-items:center; gap:10px;">
                                <div class="delivery-total">
                                    @delivery.TotalDelivery.ToString("C0")
                                </div>

                                <button class="btn-pay-delivery"
                                        @onclick="() => AbrirPagoDelivery(delivery)">
                                    Pagar
                                </button>
                            </div>
                        </div>

                        <details class="delivery-expand">
                            <summary>Ver detalle</summary>

                            @foreach (var envio in delivery.Envios)
                            {
                                <div class="delivery-item-detail">
                                    <div class="delivery-main-info">
                                        <strong>Pedido #@envio.PedidoId</strong>

                                        <div class="delivery-subtext">
                                            @envio.Fecha.ToString("dd/MM HH:mm")
                                        </div>

                                        <div class="delivery-subtext">
                                            👤 @envio.Cliente
                                        </div>

                                        <div class="delivery-subtext">
                                            📍 @envio.Direccion
                                        </div>

                                        <div class="delivery-subtext">
                                            @envio.FormaPago
                                        </div>
                                    </div>

                                    <div class="delivery-products">
                                        @foreach (var producto in envio.Productos)
                                        {
                                            <div>• @producto</div>
                                        }
                                    </div>

                                    <div class="delivery-amounts">
                                        <div>Pedido: @envio.TotalPedido.ToString("C0")</div>
                                        <div>Envío: @envio.Envio.ToString("C0")</div>
                                    </div>
                                </div>
                            }
                        </details>
                    }
                }
                else
                {
                    <div class="empty-report">
                        No hubo deliveries en este período
                    </div>
                }
            </div>


        </div>

    </div>
</div>

<div id="print-only">

    <h1>Informe de Ventas</h1>

    <p>
        Desde: @FechaDesde?.ToString("dd/MM/yyyy")
        -
        Hasta: @FechaHasta?.ToString("dd/MM/yyyy")
    </p>

    <hr />

    <h2>Resumen</h2>

    <table class="print-table">
        <tr>
            <td>Ventas Totales</td>
            <td>@Informe.VentasTotales.ToString("C0")</td>
        </tr>
        <tr>
            <td>Cantidad de Ventas</td>
            <td>@Informe.CantidadVentas</td>
        </tr>
        <tr>
            <td>Pedidos Delivery</td>
            <td>@Informe.PedidosDelivery</td>
        </tr>
        <tr>
            <td>Pedidos Retiro</td>
            <td>@Informe.PedidosRetiro</td>
        </tr>
        <tr>
            <td>Promedio por Venta</td>
            <td>@Informe.PromedioPorVenta.ToString("C0")</td>
        </tr>
    </table>

    <h2>Formas de Pago</h2>

    <table class="print-table">
        <thead>
            <tr>
                <th>Forma de Pago</th>
                <th>Cantidad</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Informe.FormasPago)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Cantidad</td>
                    <td>@item.Total.ToString("C0")</td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Productos más vendidos</h2>

    <table class="print-table">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Cantidad</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var producto in Informe.ProductosMasVendidos)
            {
                <tr>
                    <td>@producto.Nombre</td>
                    <td>@producto.Cantidad</td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Deliveries a pagar</h2>

    <table class="print-table">
        <thead>
            <tr>
                <th>Delivery</th>
                <th>Envíos</th>
                <th>Total a pagar</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var delivery in Informe.Deliveries)
            {
                <tr>
                    <td>@delivery.Nombre</td>
                    <td>@delivery.CantidadEnvios</td>
                    <td>@delivery.TotalDelivery.ToString("C0")</td>
                </tr>
            }
        </tbody>
    </table>

</div>

@if (MostrarModalPago && DeliverySeleccionado != null)
{
    <div class="modal-backdrop">
        <div class="modal-content-custom">

            <h3>Pagar a @DeliverySeleccionado.Nombre</h3>

            <p>
                Total a pagar:
                <strong>@DeliverySeleccionado.TotalDelivery.ToString("C0")</strong>
            </p>

            <div class="mb-3">
                <label>Forma de pago</label>

                <select class="form-select" @bind="FormaPagoSeleccionado">
                    <option value="@FormaPago.Efectivo">Efectivo</option>
                    <option value="@FormaPago.Transferencia">Transferencia</option>
                    <option value="@FormaPago.MercadoPago">Mercado Pago</option>
                </select>
            </div>

            <div class="modal-actions">
                <button class="btn-cancel"
                        @onclick="() => MostrarModalPago = false">
                    Cancelar
                </button>

                <button class="btn-confirm"
                        @onclick="ConfirmarPagoDelivery">
                    Confirmar pago
                </button>
            </div>

        </div>
    </div>
}
@code {

    private DateTime? FechaDesde = DateTime.Today;
    private DateTime? FechaHasta = DateTime.Today;
    private InformeDashboardDto Informe = new();

    private DeliveryInformeDto? DeliverySeleccionado;
    private bool MostrarModalPago;
    private FormaPago FormaPagoSeleccionado = FormaPago.Efectivo;


    private string PeriodoSeleccionado { get; set; } = "Hoy";

    protected override async Task OnInitializedAsync()
    {
        await BuscarAsync();
    }

    private async Task Imprimir()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task BuscarAsync()
    {
        Console.WriteLine("ENTRO A BUSCAR");
        var hoy = DateTime.Today;

        switch (PeriodoSeleccionado)
        {
            case "Hoy":
                FechaDesde = hoy;
                FechaHasta = hoy;
                break;

            case "Esta semana":
                int diasDesdeLunes = ((int)hoy.DayOfWeek + 6) % 7;
                FechaDesde = hoy.AddDays(-diasDesdeLunes);
                FechaHasta = hoy;
                break;

            case "Este mes":
                FechaDesde = new DateTime(hoy.Year, hoy.Month, 1);
                FechaHasta = hoy;
                break;

            case "Personalizado":
                // usa las fechas elegidas por el usuario
                break;
        }

        if (FechaDesde == null || FechaHasta == null)
            return;

        var filtro = new InformeFiltroDto
        {
            FechaDesde = FechaDesde.Value.Date,
            FechaHasta = FechaHasta.Value.Date
        };

        Informe = await InformeService.ObtenerDashboardAsync(filtro);

        StateHasChanged();
    }

    private void AbrirPagoDelivery(DeliveryInformeDto delivery)
    {
        DeliverySeleccionado = delivery;
        FormaPagoSeleccionado = FormaPago.Efectivo;
        MostrarModalPago = true;
    }

    private async Task ConfirmarPagoDelivery()
    {
        if (DeliverySeleccionado == null)
            return;

        await PagoDeliveryService.RegistrarPagoAsync(new RegistrarPagoDeliveryDto
        {
            DeliveryId = DeliverySeleccionado.DeliveryId,
            FormaPago = FormaPagoSeleccionado,
            PedidoIds = DeliverySeleccionado.Envios
                .Select(x => x.PedidoId)
                .ToList()
        });

        MostrarModalPago = false;
        DeliverySeleccionado = null;

        await BuscarAsync();
    }
}
<style>
    #print-only {
        display: none;
    }

    @@media print {

        body * {
            visibility: hidden !important;
        }

        #print-only,
        #print-only * {
            visibility: visible !important;
        }

        #print-only {
            display: block !important;
            position: fixed !important;
            top: 0;
            left: 0;
            width: 100%;
            padding: 15mm;
            background: white;
            color: black;
            z-index: 999999;
        }

        .reports-page,
        #area-imprimir,
        .sidebar,
        aside,
        nav,
        header {
            display: none !important;
        }

        .print-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .print-table th,
        .print-table td {
            border: 1px solid #ccc;
            padding: 8px;
            text-align: left;
        }

        .print-table th {
            background: #f2f2f2 !important;
        }

        @@page {
            size: A4;
            margin: 10mm;
        }
    }

    .delivery-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 14px 0;
        border-bottom: 1px solid #ececec;
    }

        .delivery-row:last-child {
            border-bottom: none;
        }

    .delivery-detail {
        margin-top: 4px;
        color: #6b7280;
        font-size: .9rem;
    }

    .delivery-total {
        font-size: 1.1rem;
        font-weight: 700;
        color: #111827;
        white-space: nowrap;
    }

    .delivery-expand {
        margin-top: 10px;
        margin-bottom: 16px;
    }

        .delivery-expand summary {
            cursor: pointer;
            color: #2563eb;
            font-weight: 600;
            font-size: .95rem;
            user-select: none;
        }

        .delivery-expand[open] summary {
            margin-bottom: 12px;
        }

    .delivery-item-detail {
        display: grid;
        grid-template-columns: 1.2fr 1fr auto;
        gap: 16px;
        padding: 14px 0;
        border-top: 1px solid #ececec;
        align-items: start;
    }

    .delivery-main-info {
        min-width: 0;
    }

    .delivery-subtext {
        margin-top: 4px;
        color: #6b7280;
        font-size: .88rem;
    }

    .delivery-products {
        color: #374151;
        font-size: .9rem;
    }

        .delivery-products div {
            margin-bottom: 4px;
        }

    .delivery-amounts {
        text-align: right;
        white-space: nowrap;
        font-size: .9rem;
        font-weight: 600;
        color: #111827;
    }

    .btn-pay-delivery {
        background: #16a34a;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 8px 14px;
        font-weight: 600;
        cursor: pointer;
    }

    .modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.45);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

    .modal-content-custom {
        width: 100%;
        max-width: 450px;
        background: white;
        border-radius: 16px;
        padding: 24px;
    }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
    }

    .btn-cancel {
        background: #e5e7eb;
        border: none;
        border-radius: 10px;
        padding: 10px 16px;
    }

    .btn-confirm {
        background: #2563eb;
        color: white;
        border: none;
        border-radius: 10px;
        padding: 10px 16px;
    }
</style>
