@page "/categorias"
@rendermode InteractiveServer
@using SistemaPedidos.Application.Features.Categorias.DTOs
@using SistemaPedidos.Application.Features.Categorias.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@inject ICategoriaService CategoriaService
@inject IWebHostEnvironment Environment

<h3>Gestión de Categorías</h3>

<div class="mb-3">
    <div class="mb-3">
        <button class="btn btn-primary" @onclick="AbrirCrear">
            Nueva Categoría
        </button>
    </div>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Imagen</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in categorias)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nombre</td>
                <td>
                    @if (!string.IsNullOrEmpty(categoria.ImagenUrl))
                    {
                        <img src="@categoria.ImagenUrl"
                             style="width:50px; height:50px; object-fit:cover; border-radius:6px;" />
                    }
                </td>
                <td>
                    <button class="btn btn-warning btn-sm me-2"
                            @onclick="() => AbrirModal(categoria)">
                        Editar
                    </button>

                    <button class="btn btn-danger btn-sm"
                            @onclick="() => Desactivar(categoria.Id)">
                        Desactivar
                    </button>
                </td>

            </tr>
        }
    </tbody>
</table>
@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">
                        @(modoEdicion ? "Editar Categoría" : "Nueva Categoría")
                    </h5>
                    <button class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label>Nombre</label>
                        <input class="form-control @(intentoGuardar && string.IsNullOrWhiteSpace(form.Nombre) ? "is-invalid" : "")"
                               @bind="form.Nombre" />

                        @if (intentoGuardar && string.IsNullOrWhiteSpace(form.Nombre))
                        {
                            <div class="invalid-feedback">
                                El nombre es obligatorio.
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label>Imagen (opcional)</label>
                        <InputFile OnChange="SeleccionarArchivo" />
                    </div>

                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarCategoria">Guardar</button>
                </div>

            </div>
        </div>
    </div>
}
@code {

    private List<CategoriaDto> categorias = new();
    private string nuevoNombre = string.Empty;

    // Variables para edición
    private bool mostrarModal = false;
    private CategoriaDto? categoriaSeleccionada;
    private string nombreEditar = string.Empty;
    private IBrowserFile? archivoSeleccionado;

    private bool modoEdicion = false;
    private bool intentoGuardar = false;

    private CategoriaFormModel form = new();
    private int? categoriaIdEditando = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarCategorias();
    }

    private void AbrirCrear()
    {
        modoEdicion = false;
        categoriaIdEditando = null;

        form = new CategoriaFormModel();
        archivoSeleccionado = null;

        intentoGuardar = false;

        mostrarModal = true;
    }

    private async Task CargarCategorias()
    {
        categorias = await CategoriaService.ObtenerSoloActivosAsync();
    }

    private async Task CrearCategoria()
    {
        if (string.IsNullOrWhiteSpace(nuevoNombre))
            return;

        await CategoriaService.CrearAsync(
            new CrearCategoriaDto
            {
                Nombre = nuevoNombre
            });

        nuevoNombre = string.Empty;

        await CargarCategorias();
    }

    private async Task Desactivar(int id)
    {
        await CategoriaService.DesactivarAsync(id);
        await CargarCategorias();
    }

    private void AbrirModal(CategoriaDto categoria)
    {
        modoEdicion = true;
        categoriaIdEditando = categoria.Id;

        form = new CategoriaFormModel
        {
            Nombre = categoria.Nombre,
            ImagenUrl = categoria.ImagenUrl
        };

        archivoSeleccionado = null;
        intentoGuardar = false;

        mostrarModal = true;
    }

    private void CerrarModal()
    {
        mostrarModal = false;
        categoriaSeleccionada = null;
        archivoSeleccionado = null;
    }

    private void SeleccionarArchivo(InputFileChangeEventArgs e)
    {
        archivoSeleccionado = e.File;
    }

    private async Task GuardarCategoria()
    {
        intentoGuardar = true;

        if (string.IsNullOrWhiteSpace(form.Nombre))
            return;

        // Guardar imagen
        if (archivoSeleccionado != null)
        {
            var carpeta = Path.Combine(Environment.WebRootPath, "images", "categorias");

            if (!Directory.Exists(carpeta))
                Directory.CreateDirectory(carpeta);

            var nombreArchivo = $"{Guid.NewGuid()}_{archivoSeleccionado.Name}";
            var rutaCompleta = Path.Combine(carpeta, nombreArchivo);

            using var stream = new FileStream(rutaCompleta, FileMode.Create);
            await archivoSeleccionado.OpenReadStream().CopyToAsync(stream);

            form.ImagenUrl = $"/images/categorias/{nombreArchivo}";
        }

        if (!modoEdicion)
        {
            await CategoriaService.CrearAsync(new CrearCategoriaDto
            {
                Nombre = form.Nombre,
                ImagenUrl = form.ImagenUrl
            });
        }
        else
        {
            await CategoriaService.ActualizarAsync(new ActualizarCategoriaDto
            {
                Id = categoriaIdEditando!.Value,
                Nombre = form.Nombre,
                ImagenUrl = form.ImagenUrl
            });
        }

        await CargarCategorias();
        CerrarModal();
    }

    private class CategoriaFormModel
    {
        public string Nombre { get; set; } = string.Empty;
        public string? ImagenUrl { get; set; }
    }

}
