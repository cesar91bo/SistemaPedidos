@page "/"
@using SistemaPedidos.Application.Features.Caja.Interfaces
@using SistemaPedidos.Application.Features.Pedidos.DTOs
@using SistemaPedidos.Application.Features.Pedidos.Interfaces
@using SistemaPedidos.Application.Features.Ventas
@using SistemaPedidos.Application.Features.Ventas.DTOs
@using SistemaPedidos.Infrastructure.Services.Pedidos

@inject IVentaService VentaService
@inject IPedidoService PedidoService
@inject ICajaService CajaService

<div class="topbar">
    <div>
        <h1>Panel Principal</h1>
        <span>@DateTime.Now.ToString("dddd dd 'de' MMMM")</span>
    </div>

    <a class="new-order-btn" href="/pedidos">+ Nuevo Pedido</a>
</div>

<PageTitle>Dashboard</PageTitle>

@if (!hayCajaAbierta)
{
    <div class="alert-caja">
        <div>
            <strong>No hay una caja abierta.</strong><br />
            Debe abrir la caja para comenzar a cobrar pedidos.
        </div>

        <a href="/caja" class="btn-abrir-caja">
            Abrir caja
        </a>
    </div>
}

<div class="dashboard-grid">

    <div class="stats-card sales">
        <div>
            <span class="card-label">Ventas del día</span>
            <h2>@ventasDelDia.ToString("C0")</h2>
            @if (porcentajeVsAyer.HasValue)
            {
                <small>
                    @(porcentajeVsAyer >= 0 ? "+" : "")
                    @porcentajeVsAyer.Value.ToString("0")
                    % respecto a ayer
                </small>
            }
        </div>
        <div class="card-icon">💰</div>
    </div>

    <div class="stats-card orders">
        <div>
            <span class="card-label">Pedidos activos</span>
            <h2>@(pedidosEnPreparacion + pedidosListos + pedidosEnCamino)</h2>

            <small>
                @pedidosEnPreparacion en preparación ·
                @pedidosListos listos ·
                @pedidosEnCamino enviados
            </small>
        </div>

        <div class="card-icon">
            @if (pedidosEnCamino > 0)
            {
                <span>🛵</span>
            }
            else if (pedidosListos > 0)
            {
                <span>📦</span>
            }
            else
            {
                <span>👨‍🍳</span>
            }
        </div>
    </div>

    <div class="stats-card pending">
        <div>
            <span class="card-label">Ventas realizadas</span>
            <h2>@cantidadVentasHoy</h2>
            <small>Pedidos cobrados hoy</small>
        </div>
        <div class="card-icon">🧾</div>
    </div>

    <div class="stats-card average">
        <div>
            <span class="card-label">Por cobrar</span>
            <h2>@montoPendienteCobro.ToString("C0")</h2>
            <small>@cantidadPendientesCobro pedidos pendientes de cobro</small>
        </div>
        <div class="card-icon">💵</div>
    </div>

</div>

<div class="dashboard-bottom">

    <div class="panel large-panel">
        <div class="panel-header">
            <h3>Últimos pedidos</h3>
            <a href="/pedidos">Ver todos</a>
        </div>

        <table class="orders-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Estado</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @if (ultimosPedidos.Any())
                {
                    @foreach (var pedido in ultimosPedidos)
                    {
                        <tr>
                            <td>#@pedido.Id</td>
                            <td>@pedido.NombreCliente</td>
                            <td>
                                <span class="status @ObtenerClaseEstado(pedido.Estado)">
                                    @pedido.EstadoNombre
                                </span>
                            </td>
                            <td>@pedido.TotalGeneral.ToString("C0")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align:center; color:#6b7280; padding:30px;">
                            No hay pedidos activos
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="panel">
        <h3>Productos más vendidos del día</h3>

        @if (productosMasVendidos.Any())
        {
            @foreach (var producto in productosMasVendidos)
            {
                <div class="product-item">
                    <span>@producto.Nombre</span>
                    <strong>@producto.CantidadVendida</strong>
                </div>
            }
        }
        else
        {
            <div class="product-item">
                <span>No hay ventas hoy</span>
            </div>
        }
    </div>

</div>

@code {
    private decimal ventasDelDia = 0;
    private decimal ventasAyer = 0;
    private decimal? porcentajeVsAyer = null;
    private int pedidosEnPreparacion;
    private int pedidosListos;
    private int pedidosEnCamino;
    private int cantidadVentasHoy;
    private decimal montoPendienteCobro;
    private int cantidadPendientesCobro;
    private List<PedidoDto> ultimosPedidos = new();
    private List<ProductoMasVendidoDto> productosMasVendidos = new();
    private bool hayCajaAbierta;

    protected override async Task OnInitializedAsync()
    {
        hayCajaAbierta = await CajaService.HayCajaAbiertaAsync();
        ventasDelDia = await VentaService.ObtenerTotalVentasDelDiaAsync();
        ventasAyer = await VentaService.ObtenerTotalVentasDeAyerAsync();
        productosMasVendidos = await VentaService.ObtenerProductosMasVendidosAsync();

        if (ventasAyer > 0)
        {
            porcentajeVsAyer = ((ventasDelDia - ventasAyer) / ventasAyer) * 100;
        }

        var pedidosActivos = await PedidoService.ObtenerActivosAsync();

        ultimosPedidos = pedidosActivos
            .OrderByDescending(x => x.Fecha)
            .Take(5)
            .ToList();

        pedidosEnPreparacion = pedidosActivos.Count(x => x.Estado == 1);
        pedidosListos = pedidosActivos.Count(x => x.Estado == 2);
        pedidosEnCamino = pedidosActivos.Count(x => x.Estado == 3);

        cantidadVentasHoy = await VentaService.ObtenerCantidadVentasDelDiaAsync();

        var pedidosPendientesCobro = pedidosActivos
            .Where(x => x.Estado == 2 || x.Estado == 3)
            .ToList();

        cantidadPendientesCobro = pedidosPendientesCobro.Count;
        montoPendienteCobro = pedidosPendientesCobro.Sum(x =>
            x.TotalGeneral - (x.TipoPedido == 2 ? x.PrecioEnvio : 0));
    }

    private string ObtenerClaseEstado(int estado)
    {
        return estado switch
        {
            1 => "preparing",
            2 => "ready",
            3 => "on-the-way",
            _ => ""
        };
    }
}

<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .stats-card {
        background: white;
        border-radius: 22px;
        padding: 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 10px 24px rgba(0,0,0,.06);
    }

    .card-label {
        color: #6b7280;
        font-size: 14px;
    }

    .stats-card h2 {
        margin: 10px 0 6px;
        font-size: 34px;
        color: #111827;
    }

    .card-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }

    .sales .card-icon {
        background: #dcfce7;
    }

    .orders .card-icon {
        background: #dbeafe;
    }

    .pending .card-icon {
        background: #fef3c7;
    }

    .average .card-icon {
        background: #ede9fe;
    }

    .dashboard-bottom {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    .panel {
        background: white;
        border-radius: 22px;
        padding: 24px;
        box-shadow: 0 10px 24px rgba(0,0,0,.06);
    }

    .panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

        .panel-header a {
            text-decoration: none;
            color: #2563eb;
            font-weight: 600;
        }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
    }

        .orders-table th,
        .orders-table td {
            padding: 14px;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

    .status {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .preparing {
        background: #fef3c7;
        color: #92400e;
    }

    .ready {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .on-the-way {
        background: #ede9fe;
        color: #6d28d9;
    }

    .product-item {
        display: flex;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid #e5e7eb;
    }

    .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 28px;
    }

    .new-order-btn {
        background: #2563eb;
        color: white !important;
        text-decoration: none;
        padding: 12px 18px;
        border-radius: 14px;
        display: inline-block;
        font-weight: 600;
    }

    @@media (max-width: 1200px) {
        .dashboard-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .dashboard-bottom {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
    }

    .alert-caja {
        background: #fef2f2;
        border: 1px solid #fecaca;
        color: #991b1b;
        border-radius: 18px;
        padding: 18px 22px;
        margin-bottom: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-abrir-caja {
        background: #dc2626;
        color: white !important;
        text-decoration: none;
        padding: 10px 16px;
        border-radius: 12px;
        font-weight: 600;
    }

</style>
